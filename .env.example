# Local development only. Production configuration is process-injected; do not
# deploy this file or reuse these placeholder credentials.

# API environment and network policy
BOARDTRACE_ENVIRONMENT=development
BOARDTRACE_DEBUG=false
BOARDTRACE_LOG_LEVEL=INFO
BOARDTRACE_LOG_FORMAT=console
BOARDTRACE_CORS_ALLOWED_ORIGINS=["http://localhost:3000"]
BOARDTRACE_TRUSTED_HOSTS=["localhost","127.0.0.1"]

# PostgreSQL application runtime identity (development placeholder)
BOARDTRACE_DATABASE_URL=postgresql+asyncpg://boardtrace:boardtrace@localhost:5432/boardtrace
BOARDTRACE_DATABASE_ECHO=false
BOARDTRACE_DATABASE_POOL_SIZE=5
BOARDTRACE_DATABASE_MAX_OVERFLOW=10
BOARDTRACE_DATABASE_POOL_TIMEOUT=30
BOARDTRACE_DATABASE_POOL_RECYCLE=1800

# Redis/Celery broker (development placeholder)
BOARDTRACE_REDIS_URL=redis://localhost:6379/0
BOARDTRACE_RATE_LIMIT_ENABLED=false
BOARDTRACE_ANALYSIS_QUEUE_NAME=boardtrace.analysis.jobs
BOARDTRACE_ANALYSIS_LEASE_SECONDS=120
BOARDTRACE_ANALYSIS_HEARTBEAT_SECONDS=30
BOARDTRACE_ANALYSIS_TASK_SOFT_TIME_LIMIT_SECONDS=170
BOARDTRACE_ANALYSIS_TASK_TIME_LIMIT_SECONDS=180
BOARDTRACE_ANALYSIS_AUTOMATIC_RETRY_ENABLED=false
BOARDTRACE_ANALYSIS_RETRY_BASE_DELAY_SECONDS=30
BOARDTRACE_ANALYSIS_RETRY_MAX_DELAY_SECONDS=900
BOARDTRACE_ANALYSIS_RETRY_MAX_JITTER_SECONDS=5

# Backend worker engine. The deployment operator provisions and verifies this path.
BOARDTRACE_STOCKFISH_PATH=/usr/local/bin/stockfish
BOARDTRACE_STOCKFISH_TIMEOUT_SECONDS=30
BOARDTRACE_STOCKFISH_THREADS=1
BOARDTRACE_STOCKFISH_HASH_MB=64
BOARDTRACE_ANALYSIS_DEPTH=12
BOARDTRACE_ANALYSIS_MAX_POSITION_TIME_MS=500
BOARDTRACE_ANALYSIS_MAX_GAME_TIME_MS=60000
BOARDTRACE_ANALYSIS_MAX_MOVES=300
BOARDTRACE_ANALYSIS_MAX_POSITIONS=301

# Authentication development placeholders. Inject distinct high-entropy production
# values through the deployment secret authority; never commit those values.
BOARDTRACE_JWT_SIGNING_SECRET=replace-with-local-secret-at-least-32-chars
BOARDTRACE_REFRESH_TOKEN_PEPPER=replace-with-different-local-pepper-32-chars

# Next.js server-only API endpoint. Never expose it with NEXT_PUBLIC_.
BOARDTRACE_API_URL=http://localhost:8000

# Public extension endpoint, embedded at build time. Production builds require
# explicit non-local HTTPS.
BOARDTRACE_EXTENSION_API_BASE_URL=http://127.0.0.1:18080
